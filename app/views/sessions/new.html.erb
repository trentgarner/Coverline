<% content_for :title, "Sign in" %>
<div class="row justify-content-center">
  <div class="col-sm-8 col-md-5 col-lg-4">
    <div class="card shadow-sm mt-5">
      <div class="card-body p-4">
        <h1 class="h4 mb-1">Coverline</h1>
        <p class="text-body-secondary mb-4">Sign in to see the board.</p>
        <%= form_with url: session_path do |form| %>
          <div class="mb-3">
            <%= form.label :email_address, "Email", class: "form-label" %>
            <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "form-control" %>
          </div>
          <div class="mb-3">
            <%= form.label :password, class: "form-label" %>
            <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "form-control" %>
          </div>
          <%= form.submit "Sign in", class: "btn btn-primary w-100" %>
        <% end %>
        <div class="mt-3 text-center small"><%= link_to "Forgot password?", new_password_path %></div>
      </div>
    </div>
  </div>
</div>
