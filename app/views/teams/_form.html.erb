<%= form_with model: team do |f| %>
  <% if team.errors.any? %><div class="alert alert-danger"><ul class="mb-0"><% team.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div><% end %>
  <div class="mb-3"><%= f.label :name, class: "form-label" %><%= f.text_field :name, class: "form-control", autofocus: true %></div>
  <%= f.submit class: "btn btn-primary" %> <%= link_to "Cancel", (team.persisted? ? team_path(team) : teams_path), class: "btn btn-outline-secondary" %>
<% end %>
