<%= form_with model: user, url: (user.persisted? ? agent_path(user) : agents_path), scope: :user, data: { controller: "agent-role" } do |f| %>
  <% if user.errors.any? %>
    <div class="alert alert-danger"><ul class="mb-0"><% user.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
  <% end %>
  <div class="row g-3">
    <div class="col-md-6"><%= f.label :first_name, class: "form-label" %><%= f.text_field :first_name, class: "form-control", autofocus: !user.persisted? %></div>
    <div class="col-md-6"><%= f.label :last_name, class: "form-label" %><%= f.text_field :last_name, class: "form-control" %></div>
    <div class="col-md-6"><%= f.label :email_address, "Email (their login)", class: "form-label" %><%= f.email_field :email_address, class: "form-control" %></div>
    <div class="col-md-6"><%= f.label :phone_agent_id, "Phone system agent ID", class: "form-label" %>
      <%= f.text_field :phone_agent_id, class: "form-control" %><div class="form-text">Their login/ID in the phone system, so live status events find them.</div></div>
    <div class="col-md-6"><%= f.label :role, class: "form-label" %>
      <%= f.select :role, @assignable_roles.map { |r| [ role_label(r), r ] }, {}, class: "form-select", data: { action: "change->agent-role#toggle" } %></div>
    <div class="col-md-6" data-agent-role-target="team">
      <%= f.label :team_id, "Team", class: "form-label" %>
      <%= f.select :team_id, @teams.map { |t| [ t.name, t.id ] }, { include_blank: "No team" }, class: "form-select" %>
      <div class="form-text">Managers don't belong to a team. An admin grants them teams on the Teams page.</div>
    </div>
    <div class="col-md-6" data-controller="password-generator">
      <%= f.label :password, user.persisted? ? "New temporary password (leave blank to keep the current one)" : "Temporary password", class: "form-label" %>
      <div class="input-group">
        <%= f.password_field :password, class: "form-control", autocomplete: "new-password", minlength: 8, required: !user.persisted?, data: { password_generator_target: "input" } %>
        <button type="button" class="btn btn-outline-secondary" data-action="password-generator#generate">Generate</button>
      </div>
      <div class="form-text">At least 8 characters. Give it to them; they can change it later.</div>
    </div>
  </div>
  <div class="d-flex gap-2 mt-4">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", agents_path(role: user.role), class: "btn btn-outline-secondary" %>
  </div>
<% end %>
