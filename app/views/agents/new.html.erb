<% content_for :title, "Add person" %>
<div class="mb-3"><%= link_to "← Agents", agents_path, class: "link-secondary small" %></div>
<h1 class="h3 mb-3">Add a person</h1>
<div class="card" style="max-width: 48rem"><div class="card-body"><%= render "form", user: @user %></div></div>
<p class="mt-3 small text-body-secondary">Adding a whole team? <%= link_to "Paste a list of agents", bulk_new_agents_path %> instead.</p>
