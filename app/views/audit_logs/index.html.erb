<% content_for :title, "Audit log" %>
<h1 class="h3 mb-3">Audit log</h1>
<%= form_with url: audit_logs_path, method: :get, class: "row g-2 mb-3" do |f| %>
  <div class="col-md-3"><%= f.select :user_id, @actors.map { |u| [ u.full_name, u.id ] }, { include_blank: "Anyone", selected: params[:user_id].to_i }, class: "form-select form-select-sm" %></div>
  <div class="col-md-3"><%= f.select :action_name, @actions.map { |a| [ a.humanize, a ] }, { include_blank: "Any action", selected: params[:action_name] }, class: "form-select form-select-sm" %></div>
  <div class="col-auto"><%= f.submit "Filter", class: "btn btn-sm btn-outline-secondary" %> <%= link_to "Clear", audit_logs_path, class: "btn btn-sm btn-link" %></div>
<% end %>
<div class="card"><div class="table-responsive">
  <table class="table table-sm align-middle mb-0" id="audit-log">
    <thead><tr><th>When</th><th>Who</th><th>Action</th><th>What</th><th>Details</th></tr></thead>
    <tbody>
      <% @logs.each do |log| %>
        <tr data-action-name="<%= log.action %>">
          <td class="text-nowrap small"><%= log.created_at.in_time_zone.strftime("%b %-d, %Y %-I:%M %p") %></td>
          <td><%= log.user.full_name %></td>
          <td><span class="badge text-bg-secondary"><%= log.action.humanize %></span></td>
          <td><%= log.target_label || "—" %> <span class="text-body-secondary small"><%= log.target_type %></span></td>
          <td class="small">
            <% log.changes_hash.each do |key, value| %>
              <div><span class="text-body-secondary"><%= key.humanize %>:</span>
                <% if value.is_a?(Array) && value.size == 2 %><%= Array(value[0]).join(", ").presence || "—" %> → <%= Array(value[1]).join(", ").presence || "—" %>
                <% else %><%= Array(value).join(", ") %><% end %></div>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @logs.empty? %><tr><td colspan="5" class="text-center text-body-secondary py-4">Nothing recorded yet.</td></tr><% end %>
    </tbody>
  </table>
</div></div>
<div class="d-flex gap-2 mt-3">
  <%= link_to "← Newer", audit_logs_path(request.query_parameters.merge(page: @page - 1)), class: "btn btn-sm btn-outline-secondary" if @page > 1 %>
  <%= link_to "Older →", audit_logs_path(request.query_parameters.merge(page: @page + 1)), class: "btn btn-sm btn-outline-secondary" if @has_more %>
</div>
